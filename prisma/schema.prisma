// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Politician {
  id           String   @id @default(cuid())
  name         String
  hanjaName    String?
  party        String
  office       String // e.g. "대통령", "서울특별시장", "경기도지사"
  region       String // sido name, "전국" for president
  level        String // president | governor | mayor | assembly
  electionName String
  electionDate DateTime?
  sgId         String // NEC 선거ID
  sgTypecode   String // NEC 선거종류코드
  huboid       String? // NEC 후보자/당선인ID
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pledges    Pledge[]
  factChecks FactCheck[]
  comments   Comment[]
  ratings    Rating[]

  // 한국매니페스토실천본부 질의서 회신 원문 (선거 전 후보 인터뷰 형식 — NEC 공약과는 별개 자료)
  manifestoText       String?
  manifestoSourceFile String?
  manifestoImportedAt DateTime?

  @@unique([sgId, huboid])
  @@index([region])
  @@index([level])
}

model Pledge {
  id           String   @id @default(cuid())
  politicianId String
  politician   Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  order   Int
  realm   String? // 공약분야 (경제·산업, 정치·사법 등)
  source  String  @default("nec") // nec(중앙선거관리위원회 제출 공식 선거공약) | manifesto(한국매니페스토실천본부 제출 10대 핵심공약)
  title   String
  goal    String // 목표
  method  String // 이행방법
  timeline String // 이행기간
  funding String // 재원조달방안

  // 확정형(수치·기한 등 검증 가능) vs 선언형(구호성, 판정 보류)
  measurability String @default("unrated") // measurable | declarative | unrated

  // 이행 상태 5단계 — 반드시 statusSource와 함께 기록
  status          String    @default("unrated") // completed | in_progress | partial | delayed | failed | unrated
  statusNote      String?
  statusSource    String? // 판정 근거 출처 URL/설명
  statusCheckedAt DateTime?

  // 진도율 보조 지표 (0-100) — 판정을 대체하지 않는 시각화 보조 수치.
  // 이행방법의 세부 항목별 진행도(progressBreakdown)를 근거 확인된 항목만 평균낸 값.
  // 세부 항목이 없는 공약은 기존 6단계 방식(판정전 0/검토중 10/착수 30/추진중 55/마무리 80/완료 100) 유지.
  progressPercent Int @default(0)

  // 이행방법 세부 항목별 체크리스트 (JSON 배열): [{item, percent, note, source}]
  // percent는 0/33/66/100, 근거를 찾지 못한 항목은 배열에서 제외(진도율 평균 계산에도 미포함)
  progressBreakdown String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([politicianId])
  @@index([status])
}

model FactCheck {
  id             String      @id @default(cuid())
  politicianId   String?
  politician     Politician? @relation(fields: [politicianId], references: [id])
  politicianName String // free-text fallback for people not tracked as a Politician (e.g. 국회의원)

  claim         String // the actual quote/claim being checked
  context       String // when/where it was said (e.g. "2026.8.15 광복절 경축사")
  contextSource String? // URL of the original statement (news article, speech transcript)

  // PolitiFact Truth-O-Meter식 6단계
  verdict     String // true | mostly_true | half_true | mostly_false | false | unverifiable
  explanation String // 판정 근거 설명
  sources     String // 근거 출처 (줄바꿈으로 구분된 URL/설명 목록)

  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([politicianId])
  @@index([verdict])
  comments FactCheckComment[]
}

model Comment {
  id           String     @id @default(cuid())
  politicianId String
  politician   Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  author  String
  content String

  createdAt DateTime @default(now())

  @@index([politicianId])
}

model FactCheckComment {
  id          String    @id @default(cuid())
  factCheckId String
  factCheck   FactCheck @relation(fields: [factCheckId], references: [id], onDelete: Cascade)

  author  String
  content String

  createdAt DateTime @default(now())

  @@index([factCheckId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String // "salt:hash" (scrypt)
  nickname     String
  createdAt    DateTime @default(now())

  ratings      Rating[]
  boardPosts   BoardPost[]
  boardComments BoardComment[]
}

model BoardPost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  views     Int      @default(0)
  createdAt DateTime @default(now())

  comments BoardComment[]

  @@index([createdAt])
}

model BoardComment {
  id        String    @id @default(cuid())
  postId    String
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime  @default(now())

  @@index([postId])
}

model Rating {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  politicianId String
  politician   Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  score Int // 1-5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, politicianId])
  @@index([politicianId])
}
